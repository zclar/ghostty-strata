# Amber Strata — modern amber CRT for Ghostty.
# The theme and shader paths below resolve inside ~/.config/ghostty after install.

theme = Amber Strata

# Typography is owned by font.ghostty so selecting a face replaces it instead
# of appending a fallback behind Terminus.
font-size = 15
adjust-cell-height = 8%
# The installer always creates this file; optional keeps source previews valid.
config-file = ?font.ghostty

# Comfortable modern framing.
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = background
window-decoration = client
window-titlebar-background = #0b0601
window-titlebar-foreground = #ea851d
window-title-font-family = DM Mono
window-subtitle = working-directory
window-theme = ghostty
gtk-titlebar = true
gtk-titlebar-style = tabs
gtk-tabs-location = top
gtk-toolbar-style = flat
gtk-wide-tabs = false
gtk-custom-css = styles/amber-strata.css

# Opaque pixels give the phosphor bloom a stable black-brown base.
background-opacity = 1
background-opacity-cells = false
background-blur = false

# Native cursor and bell behavior; the shader supplies the motion trail.
cursor-style = block
cursor-style-blink = false
# The shader draws the visible cursor so it can animate true block opacity.
cursor-opacity = 0
cursor-color = #ffaa20
# Keep the source glyph visible under the transparent native cursor. The
# shader applies the dark inverse only while its animated block is visible.
cursor-text = #ea851d
bell-features = no-system,no-audio,attention,title,no-border

# Switchable effect profile. Ghostty hot-reloads this installed shader file.
custom-shader = shaders/active.glsl
custom-shader-animation = true

# Keep splits and overlays inside the Amber Strata visual system.
split-divider-color = #6a3c0d
unfocused-split-opacity = 0.92
unfocused-split-fill = #100902
resize-overlay = always
resize-overlay-position = center
resize-overlay-duration = 350ms

# Familiar controls used by the earlier WezTerm version.
keybind = ctrl+w=close_tab
keybind = ctrl+shift+p=toggle_command_palette

# UI-accessible profile controls. Use these from a normal shell prompt.
command-palette-entry = title:"Amber Strata: Glow On",description:"Enable phosphor glow (run at a shell prompt).",action:"text:~/.config/ghostty/profile.sh glow-on\n"
command-palette-entry = title:"Amber Strata: Display-Safe Glow",description:"Use tighter glow that preserves matrix nodes (run at a shell prompt).",action:"text:~/.config/ghostty/profile.sh glow-soft\n"
command-palette-entry = title:"Amber Strata: Glow Off",description:"Disable phosphor glow (run at a shell prompt).",action:"text:~/.config/ghostty/profile.sh glow-off\n"
command-palette-entry = title:"Amber Strata Font: Terminus",description:"Use the original Terminus face (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh terminus\n"
command-palette-entry = title:"Amber Strata Font: DM Mono",description:"Use the crisp modern face (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh modern\n"
command-palette-entry = title:"Amber Strata Font: IBM Plex Mono",description:"Use the technical modern-retro face (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh technical\n"
command-palette-entry = title:"Amber Strata Font: IBM 3270",description:"Use the readable retro face (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh retro\n"
command-palette-entry = title:"Amber Strata Display: Dot",description:"Large display text only (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh dot\n"
command-palette-entry = title:"Amber Strata Display: Square",description:"Large display text only (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh square\n"
command-palette-entry = title:"Amber Strata Display: Matrix",description:"Large display text only (run at a shell prompt).",action:"text:~/.config/ghostty/font-profile.sh matrix\n"
command-palette-entry = title:"Amber Strata: Open Settings",description:"Open the visual Amber Strata control panel (run at a shell prompt).",action:"text:~/.config/ghostty/settings.py\n"
